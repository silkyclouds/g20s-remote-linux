# JZK G20S Pro Plus remote, 2.4 GHz dongle (USB 4842:0001, "HAOBO Technology USB Composite Device").
# Scancodes were read with bin/g20-capture. Keys that desktops act on (Power, volume, Home...) are moved to keys nobody
# binds (KEY_PROG1..4, KEY_MACRO1..4), so the PC no longer suspends / changes its own volume; g20d runs the real actions.
evdev:input:b0003v4842p0001*
 KEYBOARD_KEY_c0041=enter
 KEYBOARD_KEY_10081=prog1
 KEYBOARD_KEY_c00e9=prog2
 KEYBOARD_KEY_c00ea=prog3
 KEYBOARD_KEY_c00e2=prog4
 KEYBOARD_KEY_c0223=macro1
 KEYBOARD_KEY_c0224=esc
 KEYBOARD_KEY_7001e=macro2
 KEYBOARD_KEY_7001f=macro3
 KEYBOARD_KEY_70020=macro4
