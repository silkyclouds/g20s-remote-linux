#!/usr/bin/env python3
"""g20-switcher-server: local server of the TV-style app switcher (UI by Claude Design, served verbatim).
GET /, /api/windows, /thumbs/<id>.jpg, /icons/<id>
POST /api/toggle (key 2: open / close if in front / raise), /api/focus {id}, /api/kill {id}, /api/close
Windows are listed by a KWin script that calls back this process over D-Bus (org.g20.Switcher); thumbnails come from
KWin's ScreenShot2.CaptureWindow, so this process must run with ~/.local/libexec/g20/python3, the interpreter copy that
g20-switcher-shot.desktop authorizes. One switcher at a time, always."""
import io, json, os, re, signal, subprocess, sys, threading, time, glob
from concurrent.futures import ThreadPoolExecutor
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib
from PIL import Image

PORT = 48765
ROOT = os.path.expanduser("~/.local/share/g20-switcher")
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "g20-switcher")
os.makedirs(RUN + "/thumbs", exist_ok=True); os.makedirs(RUN + "/js", exist_ok=True)
TITLE = "Open apps"                      # <title> of the Claude Design page = the switcher window
def browser_command(path="/", kiosk=True, extra=()):
    """Chrome / Chromium in kiosk app mode on the local page. Override with G20_BROWSER="full command" (the URL is appended)."""
    import shutil
    url = "http://127.0.0.1:%d%s" % (PORT, path)
    flags = ["--app=" + url] + (["--kiosk"] if kiosk else []) + ["--no-first-run", "--no-default-browser-check", "--disable-features=Translate",
             "--autoplay-policy=no-user-gesture-required"] + list(extra)
    if os.environ.get("G20_BROWSER"):
        return os.environ["G20_BROWSER"].split() + ["--app=" + url, "--kiosk"]
    for b in ("google-chrome-stable", "google-chrome", "chromium", "chromium-browser"):
        if shutil.which(b):
            return [b, "--user-data-dir=" + os.path.expanduser("~/.config/g20-switcher-profile")] + flags
    home = os.path.expanduser("~")
    for app in ("com.google.Chrome", "org.chromium.Chromium"):
        if shutil.which("flatpak") and subprocess.run(["flatpak", "info", app], capture_output=True).returncode == 0:
            return ["flatpak", "run", app, "--user-data-dir=%s/.var/app/%s/config/g20-switcher" % (os.path.realpath(home), app)] + flags
    sys.exit("No Chrome/Chromium found: install one or set G20_BROWSER")
browser_command()          # fail early if no browser is available
SKIP_CLASSES = re.compile(r"plasmashell|xwaylandvideobridge|krunner|steamwebhelper|ksmserver|kwin", re.I)
def log(*a): print(*a, flush=True)

# ---------- D-Bus: answers from KWin scripts ----------
pending, lock = {}, threading.Lock()
XML = '<node><interface name="org.g20.Switcher"><method name="Report"><arg type="s" name="json" direction="in"/><arg type="s" name="tag" direction="in"/></method></interface></node>'
def on_call(conn, sender, path, iface, method, params, inv):
    js, tag = params.unpack()
    with lock: slot = pending.get(tag)
    if slot:
        try: slot["data"] = json.loads(js)
        except Exception: slot["data"] = None
        slot["ev"].set()
    inv.return_value(None)
def dbus_thread():
    def on_bus(conn, name):
        conn.register_object("/org/g20/Switcher", Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0], on_call, None, None)
    Gio.bus_own_name(Gio.BusType.SESSION, "org.g20.Switcher", Gio.BusNameOwnerFlags.REPLACE, on_bus, None, None)
    GLib.MainLoop().run()
threading.Thread(target=dbus_thread, daemon=True).start()

def kwin(body, wait=False, timeout=6):
    tag = "t%d" % int(time.time() * 1000000)
    ev = threading.Event(); slot = {"ev": ev, "data": None}
    if wait:
        with lock: pending[tag] = slot
    path = "%s/js/%s.js" % (RUN, tag)
    open(path, "w").write(body.replace("__TAG__", tag))
    env = dict(os.environ, WAYLAND_DISPLAY="wayland-0")
    sid = subprocess.run(["qdbus", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript", path, tag], capture_output=True, text=True, env=env).stdout.strip()
    subprocess.run(["qdbus", "org.kde.KWin", "/Scripting/Script" + sid, "org.kde.kwin.Script.run"], capture_output=True, env=env)
    res = None
    if wait: ev.wait(timeout); res = slot["data"]; 
    subprocess.run(["qdbus", "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", tag], capture_output=True, env=env)
    with lock: pending.pop(tag, None)
    try: os.remove(path)
    except OSError: pass
    return res

LIST_JS = """
const out = workspace.stackingOrder.map(w => ({id: String(w.internalId), pid: w.pid, cls: w.resourceClass || "", desktop: w.desktopFileName || "",
  title: w.caption || "", normal: !!w.normalWindow, skip: !!w.skipTaskbar, min: !!w.minimized, full: !!w.fullScreen,
  w: Math.round(w.frameGeometry.width), h: Math.round(w.frameGeometry.height), active: w === workspace.activeWindow}));
callDBus("org.g20.Switcher", "/org/g20/Switcher", "org.g20.Switcher", "Report", JSON.stringify(out), "__TAG__");
"""
def focus_js(target, close_switcher=True):
    return """const target = %s;
for (const w of workspace.windowList()) { if (String(w.internalId) === target) { w.minimized = false; workspace.activeWindow = w; } }
%s""" % (json.dumps(target), ("for (const w of workspace.windowList()) { if (w.caption === %s && /chrome/i.test(w.resourceClass || '')) w.closeWindow(); }" % json.dumps(TITLE)) if close_switcher else "")
RAISE_SWITCHER_JS = """for (const w of workspace.windowList()) { if (w.caption === %s && /chrome/i.test(w.resourceClass || '')) { w.minimized = false; w.fullScreen = true; workspace.activeWindow = w; } }""" % json.dumps(TITLE)
CLOSE_SWITCHER_JS = """for (const w of workspace.windowList()) { if (w.caption === %s && /chrome/i.test(w.resourceClass || '')) w.closeWindow(); }""" % json.dumps(TITLE)

# ---------- names / icons ----------
_names = {}
def app_info(w):
    key = (w["desktop"], w["cls"])
    if key in _names: return _names[key]
    name, icon = None, None
    for cand in [w["desktop"], w["cls"], w["cls"].lower(), w["cls"].split(".")[-1], w["cls"].split(".")[-1].lower()]:
        if not cand: continue
        try:
            ai = Gio.DesktopAppInfo.new(cand if cand.endswith(".desktop") else cand + ".desktop")
        except Exception: ai = None
        if ai:
            name = ai.get_name(); ic = ai.get_icon()
            icon = ic.get_names()[0] if ic and hasattr(ic, "get_names") and ic.get_names() else None
            break
    if icon: icon = find_icon(icon)
    _names[key] = (name or (w["cls"].split(".")[-1].capitalize() if w["cls"] else ""), icon); return _names[key]
def find_icon(name):
    if os.path.isabs(name) and os.path.exists(name): return name
    pats = [os.path.expanduser("~/.local/share/icons/hicolor/*/apps/%s.*" % name), "/usr/share/icons/hicolor/*/apps/%s.*" % name,
            os.path.expanduser("~/.local/share/flatpak/exports/share/icons/hicolor/*/apps/%s.*" % name),
            "/var/lib/flatpak/exports/share/icons/hicolor/*/apps/%s.*" % name, "/usr/share/pixmaps/%s.*" % name]
    best = None
    for p in pats:
        for f in glob.glob(p):
            if f.endswith((".png", ".svg")):
                m = re.search(r"/(\d+)x\d+/", f); sz = int(m.group(1)) if m else (9999 if f.endswith(".svg") else 0)
                if best is None or sz > best[0]: best = (sz, f)
    return best[1] if best else None

# ---------- screenshots ----------
def capture(uid, outpath):
    r, wfd = os.pipe(); buf = bytearray()
    def reader():
        while True:
            b = os.read(r, 1 << 20)
            if not b: break
            buf.extend(b)
    t = threading.Thread(target=reader); t.start()
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None); fl = Gio.UnixFDList(); fl.append(wfd)
    args = GLib.Variant("(sa{sv}h)", (uid, {"include-cursor": GLib.Variant("b", False)}, 0))
    try:
        res, _ = bus.call_with_unix_fd_list_sync("org.kde.KWin", "/org/kde/KWin/ScreenShot2", "org.kde.KWin.ScreenShot2", "CaptureWindow",
                                                 args, None, Gio.DBusCallFlags.NONE, 8000, fl, None)
    finally:
        os.close(wfd); fl = None; import gc; gc.collect(); t.join(8); os.close(r)
    info = res.unpack()[0]; w, h, stride = info["width"], info["height"], info["stride"]
    im = Image.frombuffer("RGBA", (w, h), bytes(buf), "raw", "BGRA", stride, 1).convert("RGB")
    im.thumbnail((960, 540), Image.BILINEAR); im.save(outpath, "JPEG", quality=82)

# ---------- state ----------
state = {"items": [], "ready": threading.Event(), "pids": {}, "cls": {}}
pool = ThreadPoolExecutor(4)
def snapshot():
    """List windows (top first), start the screenshots, fill state."""
    data = kwin(LIST_JS, wait=True) or []
    for f in glob.glob(RUN + "/thumbs/*"): 
        try: os.remove(f)
        except OSError: pass
    wins = [w for w in reversed(data) if w["normal"] and not w["skip"] and w["pid"] and w["title"] != TITLE and "keyboard.html" not in w["cls"] and "sources.html" not in w["cls"] and "audio.html" not in w["cls"] and "notice.html" not in w["cls"] and not SKIP_CLASSES.search(w["cls"]) and w["w"] > 300 and w["h"] > 200]
    items, jobs = [], []
    for w in wins:
        key = w["id"].strip("{}"); name, icon = app_info(w)
        it = {"id": w["id"], "pid": w["pid"], "app": name, "title": w["title"], "icon": ("/icons/" + key) if icon else None,
              "thumb": "/thumbs/%s.jpg" % key, "active": w["active"], "_icon": icon}
        items.append(it)
        jobs.append(pool.submit(lambda u=w["id"], k=key: _safe_capture(u, k)))
    state["items"] = items; state["pids"] = {i["id"]: i["pid"] for i in items}; state["cls"] = {w["id"]: w["cls"] for w in wins}
    state["jobs"] = jobs; state["ready"].set(); log("snapshot:", len(items), "windows")
def _safe_capture(uid, key):
    try: capture(uid, "%s/thumbs/%s.jpg" % (RUN, key))
    except Exception as e: log("capture failed", uid, str(e)[:120])
def switcher_state():
    data = kwin(LIST_JS, wait=True) or []
    for w in data:
        if w["title"] == TITLE and re.search("chrome", w["cls"], re.I): return w
    return None

def toggle():
    sw = switcher_state()
    if sw:
        if sw["active"]: kwin(CLOSE_SWITCHER_JS); log("toggle: closed")
        else: kwin(RAISE_SWITCHER_JS); log("toggle: raised")
        return
    state["ready"].clear(); snapshot()                       # state BEFORE the switcher opens
    subprocess.Popen(browser_command(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(40):                                       # wait for the window, then raise it full screen
        time.sleep(0.25)
        if switcher_state(): kwin(RAISE_SWITCHER_JS); break
    log("toggle: opened")

def kill_app(wid):
    pid = state["pids"].get(wid); cls = state["cls"].get(wid, "")
    if not pid: return
    log("kill", pid, cls)
    try: os.kill(pid, signal.SIGTERM)
    except ProcessLookupError: return
    for _ in range(30):
        time.sleep(0.1)
        try: os.kill(pid, 0)
        except ProcessLookupError: break
    else:
        try: os.kill(pid, signal.SIGKILL)
        except ProcessLookupError: pass
    if cls.lower() == "steam":                                # Steam was killed: bring Big Picture back
        time.sleep(3)
        heal = os.path.expanduser("~/.local/bin/steam-selfheal")          # Bazzite helper when present
        cmd = [heal, "--bpm"] if os.path.exists(heal) else ["steam", "-bigpicture"]
        subprocess.Popen(["systemd-run", "--user", "--collect", "--unit=g20-steam-relaunch-%d" % int(time.time())] + cmd,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------- configuration, voice state, on-screen keyboard ----------
def load_conf():
    conf, p = {}, os.environ.get("G20_CONF") or os.path.expanduser("~/.config/g20/g20.conf")
    if os.path.exists(p):
        for l in open(p):
            l = l.strip()
            if l and not l.startswith("#") and "=" in l:
                k, v = l.split("=", 1); conf[k.strip()] = v.strip().strip('"')
    return conf
CONF = load_conf()
voice = {"state": "idle" if CONF.get("G20_VOICE_LANGS") else "off", "text": "", "lang": None}
kbd = {"target": None}                                   # uuid of the window the typed text goes to

def is_switcher(w): return w["title"] == TITLE and re.search("chrome", w["cls"], re.I)
def is_keyboard(w): return "keyboard.html" in w["cls"]
def keyboard_window():
    for w in kwin(LIST_JS, wait=True) or []:
        if is_keyboard(w): return w
    return None
KBD_CLOSE_JS = """for (const w of workspace.windowList()) { if ((w.resourceClass || '').indexOf('keyboard.html') >= 0) w.closeWindow(); }"""
KBD_RAISE_JS = """for (const w of workspace.windowList()) { if ((w.resourceClass || '').indexOf('keyboard.html') >= 0) { w.minimized = false; w.fullScreen = true; workspace.activeWindow = w; } }"""

def open_keyboard(params=None):
    """Open the on-screen keyboard (never two). Remembers the window that has the focus: the text goes there."""
    from urllib.parse import urlencode
    params = params or {}
    win = keyboard_window()
    if win: kwin(KBD_RAISE_JS); log("keyboard: raised"); return
    data = kwin(LIST_JS, wait=True) or []
    target = next((w for w in reversed(data) if w["active"] and not is_keyboard(w) and not is_switcher(w)), None) \
        or next((w for w in reversed(data) if w["normal"] and not w["skip"] and not is_keyboard(w) and not is_switcher(w)), None)
    kbd["target"] = target["id"] if target else None
    if not params.get("app") and target: params["app"] = app_info(target)[0] or "Search"
    params.setdefault("layout", CONF.get("G20_KEYBOARD_LAYOUT", "qwerty"))
    q = urlencode({k: v for k, v in params.items() if v})
    subprocess.Popen(browser_command("/keyboard.html?" + q), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(40):
        time.sleep(0.25)
        if keyboard_window(): kwin(KBD_RAISE_JS); break
    log("keyboard: opened for", kbd["target"])

def close_keyboard(refocus=True):
    kwin(KBD_CLOSE_JS)
    if refocus and kbd["target"]: kwin(focus_js(kbd["target"], close_switcher=False))

def type_text(text, submit):
    close_keyboard(); time.sleep(0.5)
    env = dict(os.environ, WAYLAND_DISPLAY="wayland-0", YDOTOOL_SOCKET=os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), ".ydotool_socket"))
    if text:
        subprocess.run(["wl-copy", "--", text], env=env, timeout=5)
        subprocess.run(["ydotool", "key", "29:1", "47:1", "47:0", "29:0"], env=env, timeout=5)        # Ctrl+V
    if submit:
        time.sleep(0.3); subprocess.run(["ydotool", "key", "28:1", "28:0"], env=env, timeout=5)         # Enter
    log("typed %d characters%s" % (len(text), " + Enter" if submit else ""))

def set_voice(body):
    voice["state"] = body.get("state", voice["state"]); voice["text"] = body.get("text", "") or ""; voice["lang"] = body.get("lang")
    if voice["state"] in ("listening", "transcribing") and not keyboard_window():
        threading.Thread(target=open_keyboard, daemon=True).start()
    if voice["state"] == "idle" and voice["text"] and body.get("submit"):
        threading.Thread(target=lambda: (time.sleep(1.0), type_text(voice["text"], True)), daemon=True).start()


# ---------- TV input (HDMI source) picker ----------
STATE_DIR = os.path.expanduser("~/.local/state/g20"); os.makedirs(STATE_DIR, exist_ok=True)
def is_sources(w): return "sources.html" in w["cls"]
SRC_CLOSE_JS = """for (const w of workspace.windowList()) { if ((w.resourceClass || '').indexOf('sources.html') >= 0) w.closeWindow(); }"""
SRC_RAISE_JS = """for (const w of workspace.windowList()) { if ((w.resourceClass || '').indexOf('sources.html') >= 0) { w.minimized = false; w.fullScreen = true; workspace.activeWindow = w; } }"""

LOGO_HINTS = [("nintendo switch 2", "switch2"), ("switch 2", "switch2"), ("nintendo switch", "nintendoswitch"), ("switch", "nintendoswitch"),
              ("playstation 5", "playstation5"), ("ps5", "playstation5"), ("playstation 4", "playstation4"), ("ps4", "playstation4"),
              ("playstation", "playstation"), ("xbox", "xbox"), ("apple tv", "appletv"), ("shield", "nvidia"), ("nvidia", "nvidia"),
              ("raspberry", "raspberrypi"), ("roku", "roku"), ("steam deck", "steamdeck"), ("steam", "steam"), ("kodi", "kodi"),
              ("plex", "plex"), ("jellyfin", "jellyfin"), ("bazzite", "bazzite"), ("linux", "linux")]
LOGO_DIRS = [os.path.expanduser("~/.config/g20/logos"), ROOT + "/logos"]
def find_logo(name):
    for d in LOGO_DIRS:
        for ext in ("svg", "png", "webp", "jpg"):
            if os.path.exists("%s/%s.%s" % (d, name, ext)): return "/logos/%s.%s" % (name, ext)
        if os.path.exists("%s/%s" % (d, name)): return "/logos/" + name
    return None

def sources_list():
    """G20_SOURCES="hdmi1:Nintendo Switch,hdmi2:PC:mylogo,hdmi3,hdmi4"  -> id:label[:logo]. The logo is a file name (without extension)
    looked up in ~/.config/g20/logos then in the built-in logos; when omitted it is guessed from the label."""
    last = open(STATE_DIR + "/source").read().strip() if os.path.exists(STATE_DIR + "/source") else None
    items = []
    for part in CONF.get("G20_SOURCES", "hdmi1,hdmi2,hdmi3,hdmi4").split(","):
        bits = part.strip().split(":")
        sid, label, logo = bits[0].strip(), (bits[1].strip() if len(bits) > 1 else ""), (bits[2].strip() if len(bits) > 2 else "")
        if not sid: continue
        m = re.match(r"(?i)^hdmi\s*(\d+)$", sid)
        if not logo and label:
            low = label.lower(); logo = next((n for k, n in LOGO_HINTS if k in low), "")
        items.append({"id": sid, "name": ("HDMI %s" % m.group(1)) if m else sid, "label": label or None,
                      "logo": find_logo(logo) if logo else None, "active": sid == last})
    return items

def toggle_sources():
    data = kwin(LIST_JS, wait=True) or []
    win = next((w for w in data if is_sources(w)), None)
    if win:
        kwin(SRC_CLOSE_JS if win["active"] else SRC_RAISE_JS); return
    subprocess.Popen(browser_command("/sources.html"), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(40):
        time.sleep(0.25)
        if any(is_sources(w) for w in (kwin(LIST_JS, wait=True) or [])): kwin(SRC_RAISE_JS); break


def source_key(cur):
    """Source key pressed (Home Assistant reports the TV's current input in `cur`):
    - the TV shows this PC (cur is G20_PC_INPUT, default hdmi4, or unknown): show the input picker here;
    - the TV is on another input (you cannot see this PC): select the NEXT input of G20_SOURCES blindly, press again for the next one."""
    cur = (cur or "").strip().lower()
    ids = [i["id"].lower() for i in sources_list()]
    pc = [x.strip().lower() for x in CONF.get("G20_PC_INPUT", "hdmi4").split(",") if x.strip()]
    log("source key: TV input =", repr(cur), "pc =", pc)
    if not cur or cur in pc:
        toggle_sources(); return
    nxt = ids[(ids.index(cur) + 1) % len(ids)] if cur in ids else ids[0]      # TV tuner or unknown input: start at the first
    log("source key: blind cycle ->", nxt); select_source(nxt, close=False)

def select_source(sid, close=True):
    open(STATE_DIR + "/source", "w").write(sid)
    cmd = CONF.get("G20_CMD_SOURCE")
    try:
        if cmd: subprocess.run(cmd, shell=True, timeout=10, env=dict(os.environ, G20_SOURCE=sid))
        elif CONF.get("G20_HA_WEBHOOK_URL"):
            import urllib.request
            r = urllib.request.Request(CONF["G20_HA_WEBHOOK_URL"], data=json.dumps({"action": "source", "source": sid}).encode(),
                                       headers={"Content-Type": "application/json"}, method="POST")
            log("source", sid, urllib.request.urlopen(r, timeout=8).status)
        else: log("source", sid, "no backend configured")
    except Exception as e: log("source", sid, "FAILED", e)
    if close: time.sleep(1.6); kwin(SRC_CLOSE_JS)


# ---------- toasts: state only. The overlays are drawn by g20-toast (Wayland layer-shell, no focus, transparent), which polls /api/notice and /api/audio ----------
audio = {"label": "", "detail": "", "verdict": None, "hold": 6000, "checks": []}
notice = {"title": "", "detail": "", "status": None, "icon": "info", "hold": 5000, "id": 0}
TOASTS = {"audio": {"state": audio, "clear": "label"}, "notice": {"state": notice, "clear": "title"}}
_toast_timer = {}

def show_toast(kind, info):
    t = TOASTS[kind]; st = t["state"]
    st.update({k: info[k] for k in st if k in info})
    if kind == "notice": st["id"] = int(time.time() * 1000)
    log("toast", kind, "|", {k: st[k] for k in st if k != "checks"})
    if _toast_timer.get(kind): _toast_timer[kind].cancel()
    def done(): st[t["clear"]] = ""                                   # the overlay disappears when its state is empty
    tm = threading.Timer(st["hold"] / 1000.0 + 1.2, done); tm.daemon = True; tm.start(); _toast_timer[kind] = tm

def show_audio(info): show_toast("audio", info)
def show_notice(info): show_toast("notice", info)

# ---------- HTTP ----------
class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def _local_only(self):
        """Loopback is trusted. From the LAN only THREE requests are allowed: POST /api/remote/{sources_open,source_key,notice}?k=<G20_REMOTE_SECRET>
        from the IP in G20_HA_IP (Home Assistant asks the PC to show the input picker when the TV is on the PC's input, or to show a scene notice)."""
        ip = self.client_address[0]
        if ip in ("127.0.0.1", "::1"): return True
        from urllib.parse import urlparse, parse_qs
        u = urlparse(self.path); k = parse_qs(u.query).get("k", [""])[0]
        ok = (self.command == "POST" and u.path in ("/api/remote/sources_open", "/api/remote/source_key", "/api/remote/notice") and CONF.get("G20_REMOTE_SECRET") and k == CONF["G20_REMOTE_SECRET"]
              and ip == CONF.get("G20_HA_IP", ""))
        if not ok: self._send(403)
        return ok

    def _send(self, code, body=b"", ctype="application/json", cache=False):
        self.send_response(code); self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store"); self.end_headers(); self.wfile.write(body)
    def _file(self, path, ctype):
        try: data = open(path, "rb").read()
        except OSError: return self._send(404)
        self._send(200, data, ctype)
    def do_GET(self):
        if not self._local_only(): return
        p = self.path.split("?")[0]
        if p in ("/", "/index.html"): return self._file(ROOT + "/index.html", "text/html; charset=utf-8")
        if p == "/keyboard.html": return self._file(ROOT + "/keyboard.html", "text/html; charset=utf-8")
        if p == "/api/voice": return self._send(200, json.dumps(voice).encode())
        if p == "/audio.html": return self._file(ROOT + "/audio.html", "text/html; charset=utf-8")
        if p == "/api/audio": return self._send(200, json.dumps(audio).encode())
        if p == "/notice.html": return self._file(ROOT + "/notice.html", "text/html; charset=utf-8")
        if p == "/api/notice": return self._send(200, json.dumps(notice).encode())
        if p == "/sources.html": return self._file(ROOT + "/sources.html", "text/html; charset=utf-8")
        if p == "/api/sources": return self._send(200, json.dumps(sources_list()).encode())
        m = re.match(r"/logos/([A-Za-z0-9._-]+)$", p)
        if m:
            for d in LOGO_DIRS:
                f = os.path.join(d, m.group(1))
                if os.path.isfile(f): return self._file(f, {"svg": "image/svg+xml", "png": "image/png", "webp": "image/webp", "jpg": "image/jpeg"}.get(f.rsplit(".", 1)[-1], "application/octet-stream"))
            return self._send(404)
        if p.startswith("/echantillons/"): return self._file(ROOT + p, "image/jpeg")
        if p == "/api/windows":
            if not state["ready"].is_set(): snapshot()
            for j in state.get("jobs", []):
                try: j.result(timeout=10)
                except Exception: pass
            items = []
            for it in state["items"]:
                key = it["id"].strip("{}"); d = {k: v for k, v in it.items() if k != "_icon"}
                if not os.path.exists("%s/thumbs/%s.jpg" % (RUN, key)): d["thumb"] = None
                items.append(d)
            return self._send(200, json.dumps(items).encode())
        m = re.match(r"/thumbs/([0-9a-f-]+)\.jpg$", p)
        if m: return self._file("%s/thumbs/%s.jpg" % (RUN, m.group(1)), "image/jpeg")
        m = re.match(r"/icons/([0-9a-f-]+)$", p)
        if m:
            for it in state["items"]:
                if it["id"].strip("{}") == m.group(1) and it.get("_icon"):
                    ic = it["_icon"]; return self._file(ic, "image/svg+xml" if ic.endswith(".svg") else "image/png")
        self._send(404)
    def do_POST(self):
        if not self._local_only(): return
        n = int(self.headers.get("Content-Length") or 0); body = {}
        if n:
            try: body = json.loads(self.rfile.read(n))
            except Exception: pass
        from urllib.parse import urlparse as _up, parse_qs as _pq
        p = self.path.split("?")[0]; q = _pq(_up(self.path).query)
        if p == "/api/remote/sources_open": threading.Thread(target=toggle_sources, daemon=True).start()
        elif p == "/api/remote/source_key": threading.Thread(target=source_key, args=(q.get("cur", [""])[0],), daemon=True).start()
        elif p == "/api/audio/show": threading.Thread(target=show_audio, args=(body,), daemon=True).start()
        elif p in ("/api/notice/show", "/api/remote/notice"): threading.Thread(target=show_notice, args=(body,), daemon=True).start()
        elif p == "/api/toggle": threading.Thread(target=toggle, daemon=True).start()
        elif p == "/api/focus": threading.Thread(target=lambda: kwin(focus_js(body.get("id", ""))), daemon=True).start()
        elif p == "/api/kill": threading.Thread(target=kill_app, args=(body.get("id", ""),), daemon=True).start()
        elif p == "/api/keyboard": threading.Thread(target=open_keyboard, args=(body,), daemon=True).start()
        elif p == "/api/type": threading.Thread(target=type_text, args=(body.get("text", ""), bool(body.get("submit", True))), daemon=True).start()
        elif p == "/api/cancel": threading.Thread(target=close_keyboard, daemon=True).start()
        elif p == "/api/voice/set": set_voice(body)
        elif p == "/api/sources/open": threading.Thread(target=toggle_sources, daemon=True).start()
        elif p == "/api/source": threading.Thread(target=select_source, args=(body.get("id", ""),), daemon=True).start()
        elif p == "/api/cancel_sources": threading.Thread(target=lambda: kwin(SRC_CLOSE_JS), daemon=True).start()
        elif p == "/api/close": threading.Thread(target=lambda: kwin(CLOSE_SWITCHER_JS), daemon=True).start()
        else: return self._send(404)
        self._send(200, b"{}")

