def voice_command(cmd):
    """Sends "start" or "cancel" to the voice daemon. Returns (http status, answer for the keyboard page)."""
    import socket as _socket
    try:
        with _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM) as c:
            c.settimeout(3); c.connect(VOICE_CTL); c.sendall(cmd.encode()); answer = c.recv(16).decode()
    except OSError:
        return 503, {"started": False, "reason": "voice daemon not running"}
    return (200, {"started": True}) if answer == "ok" else (409, {"started": False, "reason": answer})

def set_voice(body):
    voice["state"] = body.get("state", voice["state"]); voice["text"] = body.get("text", "") or ""; voice["lang"] = body.get("lang")
    voice["error"] = body.get("error")
    if voice["state"] in ("listening", "transcribing") and not keyboard_window():
        threading.Thread(target=open_keyboard, daemon=True).start()
    if voice["state"] == "idle" and voice["text"] and body.get("submit"):
        threading.Thread(target=lambda: (time.sleep(0.4), type_text(voice["text"], True)), daemon=True).start()



# ---------- OK on a text field -> open the on-screen keyboard by itself ----------
# g20d tells us when OK is pressed on the remote. A moment later we ask the application in front whether a text field has the focus:
#  - Wayland apps (Plezy, Qt, GTK, Electron with Wayland IME): KWin's VirtualKeyboard.activeClientSupportsTextInput (the text-input protocol),
#  - Steam (X11, Chromium inside): its local debug port (document.activeElement), enabled by ~/.local/share/Steam/.cef-enable-remote-debugging,
#  - an Electron / Chromium app started with --remote-debugging-port=N: list N in G20_CDP_PORTS (the active window class must match G20_CDP_APPS).
def _ws_connect(host, port, path):
    import socket, base64
    sk = socket.create_connection((host, port), timeout=3)
    key = base64.b64encode(os.urandom(16)).decode()
    sk.sendall(("GET %s HTTP/1.1\r\nHost: %s:%d\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n" % (path, host, port, key)).encode())
    buf = b""
    while b"\r\n\r\n" not in buf: buf += sk.recv(4096)
    head, rest = buf.split(b"\r\n\r\n", 1)
    if b" 101 " not in head.split(b"\r\n")[0]: raise OSError("websocket handshake refused")
    return sk, bytearray(rest)
def _ws_send(sk, text):
    import struct
    p = text.encode(); m = os.urandom(4); n = len(p); h = bytearray([0x81])
    if n < 126: h.append(0x80 | n)
    elif n < 65536: h += bytes([0x80 | 126]) + struct.pack(">H", n)
    else: h += bytes([0x80 | 127]) + struct.pack(">Q", n)
    sk.sendall(bytes(h) + m + bytes(b ^ m[i % 4] for i, b in enumerate(p)))
def _ws_recv(sk, buf):
    import struct
    def need(k):
        while len(buf) < k:
            d = sk.recv(65536)
            if not d: raise OSError("closed")
            buf.extend(d)
    out = b""
    while True:
        need(2); fin = buf[0] & 0x80; n = buf[1] & 0x7f; i = 2
        if n == 126: need(4); n = struct.unpack(">H", bytes(buf[2:4]))[0]; i = 4
        elif n == 127: need(10); n = struct.unpack(">Q", bytes(buf[2:10]))[0]; i = 10
        need(i + n); out += bytes(buf[i:i + n]); del buf[:i + n]
        if fin: return out.decode(errors="ignore")
TEXTFIELD_JS = ("(function(){var a=document.activeElement;for(var i=0;i<6&&a&&a.tagName==='IFRAME'&&a.contentDocument;i++)a=a.contentDocument.activeElement;"
                "if(!a)return false;var t=(a.tagName||'').toLowerCase();var ty=(a.type||'').toLowerCase();"
                "return (t==='input'&&['button','checkbox','radio','submit','range','file','image','reset','color'].indexOf(ty)<0)||t==='textarea'||a.isContentEditable===true})()")
def cdp_text_focus(port, only_title=None):
    """True if some page behind the Chromium debug port has a text field focused."""
    pages = json.load(urllib.request.urlopen("http://127.0.0.1:%d/json" % port, timeout=2))
    for t in pages:
        if t.get("type") != "page" or not t.get("webSocketDebuggerUrl"): continue
        if only_title and only_title not in (t.get("title") or ""): continue
        try:
            sk, buf = _ws_connect("127.0.0.1", port, "/" + t["webSocketDebuggerUrl"].split("/", 3)[3])
            _ws_send(sk, json.dumps({"id": 1, "method": "Runtime.evaluate", "params": {"expression": TEXTFIELD_JS, "returnByValue": True}}))
            r = json.loads(_ws_recv(sk, buf)); sk.close()
            if (r.get("result", {}).get("result", {}) or {}).get("value") is True: return True
        except Exception: continue
    return False

def _cdp_call(sk, buf, state, method, params=None):
    """One Chrome DevTools Protocol call on an open websocket; events that arrive meanwhile are skipped."""
    state["id"] += 1
    _ws_send(sk, json.dumps({"id": state["id"], "method": method, "params": params or {}}))
    while True:
        msg = json.loads(_ws_recv(sk, buf))
        if msg.get("id") == state["id"]: return msg.get("result", {})

def cdp_type(port, text, submit, title=None, prepare=None):
    """Types `text` into an Electron / Chromium app through its debug port, replacing what the field holds.
    `prepare` is a JavaScript expression that focuses and selects the field and returns true when it exists.
    Returns True when the text went in."""
    pages = json.load(urllib.request.urlopen("http://127.0.0.1:%d/json" % port, timeout=2))
    for t in pages:
        if t.get("type") != "page" or not t.get("webSocketDebuggerUrl"): continue
        if title and title not in (t.get("title") or ""): continue
        try:
            sk, buf = _ws_connect("127.0.0.1", port, "/" + t["webSocketDebuggerUrl"].split("/", 3)[3])
            state = {"id": 0}
            ok = True
            if prepare:
                ok = (_cdp_call(sk, buf, state, "Runtime.evaluate", {"expression": prepare, "returnByValue": True}).get("result", {}) or {}).get("value") is True
            if ok:
                _cdp_call(sk, buf, state, "Input.insertText", {"text": text})
                if submit:
                    for kind in ("keyDown", "keyUp"):
                        _cdp_call(sk, buf, state, "Input.dispatchKeyEvent", {"type": kind, "key": "Enter", "code": "Enter",
                                  "windowsVirtualKeyCode": 13, "nativeVirtualKeyCode": 13, "text": "\r" if kind == "keyDown" else ""})
            sk.close()
            if ok: return True
        except Exception as e: log("cdp_type failed on a page:", e)
    return False

STEAM_SEARCH_JS = "(function(){var e=document.querySelector('input[type=search]');if(!e)return false;e.focus();e.select();return true})()"

def cdp_target(cls):
    """(port, page title filter, preparation script) of the application whose class is `cls`, or None."""
    if cls in ("steam", "steamwebhelper"): return (8080, "Big Picture", STEAM_SEARCH_JS)
    for part in CONF.get("G20_CDP_PORTS", "").split(","):
        app, _, port = part.partition(":")
        if app and port.isdigit() and app.lower() in cls: return (int(port), None, None)
    return None


def active_window():
    data = kwin(LIST_JS, wait=True) or []
    return next((w for w in reversed(data) if w["active"]), None)

def kwin_text_input():
    try:
        out = subprocess.run(["busctl", "--user", "get-property", "org.kde.KWin", "/VirtualKeyboard", "org.kde.kwin.VirtualKeyboard", "activeClientSupportsTextInput"],
                             capture_output=True, text=True, timeout=2).stdout
        return out.strip().endswith("true")
    except Exception: return False

def text_field_active():
    """(True, how) when the application in front has a text field focused."""
    w = active_window()
    if not w or is_keyboard(w) or is_switcher(w) or is_sources(w): return (False, "ours")
    cls = (w["cls"] or "").lower()
    if cls in ("steam", "steamwebhelper"):
        try:
            if cdp_text_focus(8080, "Big Picture"): return (True, "steam")
        except Exception: pass
    for part in CONF.get("G20_CDP_PORTS", "").split(","):
        app, _, port = part.partition(":")
        if app and port.isdigit() and app.lower() in cls:
            try:
                if cdp_text_focus(int(port)): return (True, "cdp:" + app)
            except Exception: pass
    if kwin_text_input(): return (True, "kwin")
    return (False, "none")

_ok_lock = threading.Lock()
def ok_pressed():
    """The remote's OK was pressed: if it landed on a text field, show the keyboard."""
    if not _ok_lock.acquire(blocking=False): return
    try:
        if CONF.get("G20_AUTO_KEYBOARD", "1") == "0" or keyboard_window(): return
        time.sleep(0.45)                                    # let the application react to the key first (focus moves into the field)
        ok, how = text_field_active()
        log("ok pressed: text field =", ok, how)
        if ok and not keyboard_window(): open_keyboard()
    finally: _ok_lock.release()

# ---------- TV input (HDMI source) picker ----------
STATE_DIR = os.path.expanduser("~/.local/state/g20"); os.makedirs(STATE_DIR, exist_ok=True)
def is_sources(w): return "sources.html" in w["cls"]
SRC_CLOSE_JS = """for (const w of workspace.windowList()) { if ((w.resourceClass || '').indexOf('sources.html') >= 0) w.closeWindow(); }"""
SRC_RAISE_JS = """for (const w of workspace.windowList()) { if ((w.resourceClass || '').indexOf('sources.html') >= 0) { w.minimized = false; w.fullScreen = true; workspace.activeWindow = w; } }"""

LOGO_HINTS = [("nintendo switch 2", "switch2"), ("switch 2", "switch2"), ("nintendo switch", "nintendoswitch"), ("switch", "nintendoswitch"),
              ("playstation 5", "playstation5"), ("ps5", "playstation5"), ("playstation 4", "playstation4"), ("ps4", "playstation4"),
              ("playstation", "playstation"), ("xbox", "xbox"), ("apple tv", "appletv"), ("shield", "nvidia"), ("nvidia", "nvidia"),
              ("raspberry", "raspberrypi"), ("roku", "roku"), ("steam deck", "steamdeck"), ("steam", "steam"), ("kodi", "kodi"),
              ("plex", "plex"), ("jellyfin", "jellyfin"), ("bazzite", "bazzite"), ("linux", "linux")]
LOGO_DIRS = [os.path.expanduser("~/.config/g20/logos"), ROOT + "/logos"]
def find_logo(name):
    for d in LOGO_DIRS:
        for ext in ("svg", "png", "webp", "jpg"):
            if os.path.exists("%s/%s.%s" % (d, name, ext)): return "/logos/%s.%s" % (name, ext)
        if os.path.exists("%s/%s" % (d, name)): return "/logos/" + name
    return None

def sources_list():
    """G20_SOURCES="hdmi1:Nintendo Switch,hdmi2:PC:mylogo,hdmi3,hdmi4"  -> id:label[:logo]. The logo is a file name (without extension)
    looked up in ~/.config/g20/logos then in the built-in logos; when omitted it is guessed from the label."""
    last = open(STATE_DIR + "/source").read().strip() if os.path.exists(STATE_DIR + "/source") else None
    items = []
    for part in CONF.get("G20_SOURCES", "hdmi1,hdmi2,hdmi3,hdmi4").split(","):
        bits = part.strip().split(":")
        sid, label, logo = bits[0].strip(), (bits[1].strip() if len(bits) > 1 else ""), (bits[2].strip() if len(bits) > 2 else "")
        if not sid: continue
        m = re.match(r"(?i)^hdmi\s*(\d+)$", sid)
        if not logo and label:
            low = label.lower(); logo = next((n for k, n in LOGO_HINTS if k in low), "")
        items.append({"id": sid, "name": ("HDMI %s" % m.group(1)) if m else sid, "label": label or None,
                      "logo": find_logo(logo) if logo else None, "active": sid == last})
    return items

def toggle_sources():
    data = kwin(LIST_JS, wait=True) or []
    win = next((w for w in data if is_sources(w)), None)
    if win:
        kwin(SRC_CLOSE_JS if win["active"] else SRC_RAISE_JS); return
    subprocess.Popen(browser_command("/sources.html"), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(40):
        time.sleep(0.25)
        if any(is_sources(w) for w in (kwin(LIST_JS, wait=True) or [])): kwin(SRC_RAISE_JS); break


def source_key(cur):
    """Source key pressed (Home Assistant reports the TV's current input in `cur`):
    - the TV shows this PC (cur is G20_PC_INPUT, default hdmi4, or unknown): show the input picker here;
    - the TV is on another input (you cannot see this PC): select the NEXT input of G20_SOURCES blindly, press again for the next one."""
    cur = (cur or "").strip().lower()
    ids = [i["id"].lower() for i in sources_list()]
    pc = [x.strip().lower() for x in CONF.get("G20_PC_INPUT", "hdmi4").split(",") if x.strip()]
    log("source key: TV input =", repr(cur), "pc =", pc)
    if not cur or cur in pc:
        toggle_sources(); return
    nxt = ids[(ids.index(cur) + 1) % len(ids)] if cur in ids else ids[0]      # TV tuner or unknown input: start at the first
    log("source key: blind cycle ->", nxt); select_source(nxt, close=False)

def select_source(sid, close=True):
    open(STATE_DIR + "/source", "w").write(sid)
    cmd = CONF.get("G20_CMD_SOURCE")
    try:
        if cmd: subprocess.run(cmd, shell=True, timeout=10, env=dict(os.environ, G20_SOURCE=sid))
        elif CONF.get("G20_HA_WEBHOOK_URL"):
            import urllib.request
            r = urllib.request.Request(CONF["G20_HA_WEBHOOK_URL"], data=json.dumps({"action": "source", "source": sid}).encode(),
                                       headers={"Content-Type": "application/json"}, method="POST")
            log("source", sid, urllib.request.urlopen(r, timeout=8).status)
        else: log("source", sid, "no backend configured")
    except Exception as e: log("source", sid, "FAILED", e)
    if close: time.sleep(1.6); kwin(SRC_CLOSE_JS)


# ---------- toasts: state only. The overlays are drawn by g20-toast (Wayland layer-shell, no focus, transparent), which polls /api/notice and /api/audio ----------
audio = {"label": "", "detail": "", "verdict": None, "hold": 6000, "checks": []}
notice = {"title": "", "detail": "", "status": None, "icon": "info", "hold": 5000, "id": 0}
TOASTS = {"audio": {"state": audio, "clear": "label"}, "notice": {"state": notice, "clear": "title"}}
_toast_timer = {}

def show_toast(kind, info):
    t = TOASTS[kind]; st = t["state"]
    st.update({k: info[k] for k in st if k in info})
    if kind == "notice": st["id"] = int(time.time() * 1000)
    log("toast", kind, "|", {k: st[k] for k in st if k != "checks"})
    if _toast_timer.get(kind): _toast_timer[kind].cancel()
    subprocess.Popen(["systemctl", "--user", "start", "--no-block", "g20-toast@%s.service" % kind], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    def done(): st[t["clear"]] = ""                                   # the overlay disappears (and exits) when its state is empty
    # hold + its start-up time, so the card always plays out
    tm = threading.Timer(st["hold"] / 1000.0 + 4.0, done); tm.daemon = True; tm.start(); _toast_timer[kind] = tm

def show_audio(info): show_toast("audio", info)
def show_notice(info): show_toast("notice", info)

# ---------- HTTP ----------
class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def _local_only(self):
        """Loopback is trusted. From the LAN only THREE requests are allowed: POST /api/remote/{sources_open,source_key,notice}?k=<G20_REMOTE_SECRET>
        from the IP in G20_HA_IP (Home Assistant asks the PC to show the input picker when the TV is on the PC's input, or to show a scene notice)."""
        ip = self.client_address[0]
        if ip in ("127.0.0.1", "::1"): return True
        from urllib.parse import urlparse, parse_qs
        u = urlparse(self.path); k = parse_qs(u.query).get("k", [""])[0]
        ok = (self.command == "POST" and u.path in ("/api/remote/sources_open", "/api/remote/source_key", "/api/remote/notice") and CONF.get("G20_REMOTE_SECRET") and k == CONF["G20_REMOTE_SECRET"]
              and ip == CONF.get("G20_HA_IP", ""))
        if not ok: self._send(403)
        return ok

    def _send(self, code, body=b"", ctype="application/json", cache=False):
        self.send_response(code); self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store"); self.end_headers(); self.wfile.write(body)
    def _file(self, path, ctype):
        try: data = open(path, "rb").read()
        except OSError: return self._send(404)
        self._send(200, data, ctype)
    def do_GET(self):
        if not self._local_only(): return
        p = self.path.split("?")[0]
        if p in ("/", "/index.html"): return self._file(ROOT + "/index.html", "text/html; charset=utf-8")
        if p == "/keyboard.html": return self._file(ROOT + "/keyboard.html", "text/html; charset=utf-8")
        if p == "/api/voice": return self._send(200, json.dumps(dict(voice, ready=os.path.exists(VOICE_CTL))).encode())
        if p == "/audio.html": return self._file(ROOT + "/audio.html", "text/html; charset=utf-8")
        if p == "/api/audio": return self._send(200, json.dumps(audio).encode())
        if p == "/notice.html": return self._file(ROOT + "/notice.html", "text/html; charset=utf-8")
        if p == "/api/notice": return self._send(200, json.dumps(notice).encode())
        if p == "/sources.html": return self._file(ROOT + "/sources.html", "text/html; charset=utf-8")
        if p == "/api/sources": return self._send(200, json.dumps(sources_list()).encode())
        m = re.match(r"/logos/([A-Za-z0-9._-]+)$", p)
        if m:
            for d in LOGO_DIRS:
                f = os.path.join(d, m.group(1))
                if os.path.isfile(f): return self._file(f, {"svg": "image/svg+xml", "png": "image/png", "webp": "image/webp", "jpg": "image/jpeg"}.get(f.rsplit(".", 1)[-1], "application/octet-stream"))
            return self._send(404)
        if p.startswith("/echantillons/"): return self._file(ROOT + p, "image/jpeg")
        if p == "/api/windows":
            if not state["ready"].is_set(): snapshot()
            for j in state.get("jobs", []):
                try: j.result(timeout=10)
                except Exception: pass
            items = []
            for it in state["items"]:
                key = it["id"].strip("{}"); d = {k: v for k, v in it.items() if k != "_icon"}
                if not os.path.exists("%s/thumbs/%s.jpg" % (RUN, key)): d["thumb"] = None
                items.append(d)
            return self._send(200, json.dumps(items).encode())
        m = re.match(r"/thumbs/([0-9a-f-]+)\.jpg$", p)
        if m: return self._file("%s/thumbs/%s.jpg" % (RUN, m.group(1)), "image/jpeg")
        m = re.match(r"/icons/([0-9a-f-]+)$", p)
        if m:
            for it in state["items"]:
                if it["id"].strip("{}") == m.group(1) and it.get("_icon"):
                    ic = it["_icon"]; return self._file(ic, "image/svg+xml" if ic.endswith(".svg") else "image/png")
        self._send(404)
    def do_POST(self):
        if not self._local_only(): return
        n = int(self.headers.get("Content-Length") or 0); body = {}
        if n:
            try: body = json.loads(self.rfile.read(n))
            except Exception: pass
        from urllib.parse import urlparse as _up, parse_qs as _pq
        p = self.path.split("?")[0]; q = _pq(_up(self.path).query)
        if p in ("/api/voice/start", "/api/voice/cancel"):
            code, answer = voice_command(p.rsplit("/", 1)[1]); return self._send(code, json.dumps(answer).encode())
        if p == "/api/remote/sources_open": threading.Thread(target=toggle_sources, daemon=True).start()
        elif p == "/api/remote/source_key": threading.Thread(target=source_key, args=(q.get("cur", [""])[0],), daemon=True).start()
        elif p == "/api/remote/ok": threading.Thread(target=ok_pressed, daemon=True).start()
        elif p == "/api/audio/show": threading.Thread(target=show_audio, args=(body,), daemon=True).start()
        elif p in ("/api/notice/show", "/api/remote/notice"): threading.Thread(target=show_notice, args=(body,), daemon=True).start()
        elif p == "/api/toggle": threading.Thread(target=toggle, daemon=True).start()
        elif p == "/api/focus": threading.Thread(target=lambda: kwin(focus_js(body.get("id", ""))), daemon=True).start()
        elif p == "/api/kill": threading.Thread(target=kill_app, args=(body.get("id", ""),), daemon=True).start()
        elif p == "/api/keyboard": threading.Thread(target=open_keyboard, args=(body,), daemon=True).start()
        elif p == "/api/type": threading.Thread(target=type_text, args=(body.get("text", ""), bool(body.get("submit", True))), daemon=True).start()
        elif p == "/api/cancel": threading.Thread(target=close_keyboard, daemon=True).start()
        elif p == "/api/voice/set": set_voice(body)
        elif p == "/api/sources/open": threading.Thread(target=toggle_sources, daemon=True).start()
        elif p == "/api/source": threading.Thread(target=select_source, args=(body.get("id", ""),), daemon=True).start()
        elif p == "/api/cancel_sources": threading.Thread(target=lambda: kwin(SRC_CLOSE_JS), daemon=True).start()
        elif p == "/api/close": threading.Thread(target=lambda: kwin(CLOSE_SWITCHER_JS), daemon=True).start()
        else: return self._send(404)
        self._send(200, b"{}")

