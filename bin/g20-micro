#!/usr/bin/env bash
# Mic key: open the search of the application in the foreground. $1 = sanitized window class, set by g20-micro-kwin.
# Add your own apps below. Plezy: Ctrl+F opens its search page (Plezy 1.28+).
export YDOTOOL_SOCKET=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/.ydotool_socket
cls=${1:-unknown}
echo "mic: active window = $cls"
case "$cls" in
  *plezy*) ydotool key 29:1 33:1 33:0 29:0 ;;     # Ctrl+F
  *)       echo "mic: no action for this window" ;;
esac
