#!/usr/bin/env bash
# Key 2: open the app switcher; if it is already open, close it (when in front) or bring it back (when behind). Never two.
curl -s -m 5 -X POST http://127.0.0.1:48765/api/toggle >/dev/null || { systemctl --user restart g20-switcher.service; sleep 2; curl -s -m 5 -X POST http://127.0.0.1:48765/api/toggle >/dev/null; }
